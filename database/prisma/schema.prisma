generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum OtpChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PHONE_VERIFICATION
  RESET_PASSWORD
}

enum OtpStatus {
  PENDING
  SENT
  VERIFIED
  EXPIRED
  FAILED
  CANCELLED
}

enum DeviceType {
  ANDROID
  IOS
  WEB
  DESKTOP
  OTHER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  LOGGED_OUT
}

enum ContactStatus {
  PENDING
  ACCEPTED
  BLOCKED
  REMOVED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ParticipantStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SYSTEM
  STICKER
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  DELETED
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum UploadStatus {
  PENDING
  COMPLETED
  FAILED
  DELETED
}

enum ConversionStatus {
  NOT_REQUIRED
  PENDING
  SUCCESS
  FAILED
}

enum GroupJoinApprovalMode {
  OPEN
  ADMIN_APPROVAL
  INVITE_ONLY
}

enum GroupMemberAddMode {
  ADMINS_ONLY
  ALL_MEMBERS
}

enum ReportReason {
  SPAM
  ABUSE
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_ACCOUNT
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum AbuseEventType {
  OTP_ABUSE
  MESSAGE_SPAM
  LOGIN_ABUSE
  REPORT_ABUSE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  PROFILE_UPDATED
  CONVERSATION_CREATED
  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  MESSAGE_SENT
  MESSAGE_EDITED
  MESSAGE_DELETED
  MESSAGE_REPORTED
  MEDIA_UPLOADED
  USER_BLOCKED
  USER_UNBLOCKED
}

enum NotificationType {
  MESSAGE
  GROUP
  OTP
  SECURITY
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

//
// AUTH / USER DOMAIN
//

model User {
  id               String     @id @default(uuid()) @db.Uuid
  phoneNumber      String     @unique @db.VarChar(20)
  accountStatus    Boolean    @default(true)
  phoneVerified    Boolean    @default(false)
  profileCompleted Boolean    @default(false)
  username         String?    @unique @db.VarChar(50)
  displayName      String     @db.VarChar(120)
  bio              String?    @db.VarChar(255)
  avatarUrl        String?    @db.Text
  email            String?    @unique @db.VarChar(150)
  gender           Gender?
  dateOfBirth      DateTime?
  status           UserStatus @default(ACTIVE)
  lastSeenAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  privacySetting UserPrivacySetting?
  sessions       DeviceSession[]
  refreshTokens  RefreshToken[]
  otpRequests    OtpRequest[]

  contactsOwned  Contact[] @relation("ContactOwner")
  contactsLinked Contact[] @relation("ContactLinkedUser")

  blockedByMe UserBlock[] @relation("BlockerUser")
  blockedMe   UserBlock[] @relation("BlockedUser")

  createdConversations Conversation[]            @relation("ConversationCreator")
  participants         ConversationParticipant[]
  groupInvitesSent     GroupInvite[]             @relation("GroupInviteInviter")

  sentMessages     Message[]            @relation("MessageSender")
  receipts         MessageReceipt[]
  reactions        MessageReaction[]
  messageEdits     MessageEditHistory[]
  mediaUploads     MediaAsset[]         @relation("MediaUploader")
  reportsCreated   UserReport[]         @relation("ReporterUser")
  reportsAgainstMe UserReport[]         @relation("ReportedUser")
  abuseEvents      AbuseEvent[]
  auditLogs        AuditLog[]
  groupInvites     GroupInvite[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  notificationDevices    NotificationDevice[]

  @@index([displayName])
  @@index([status])
  @@index([createdAt])
}

model UserPrivacySetting {
  id                         String   @id @default(uuid()) @db.Uuid
  userId                     String   @unique @db.Uuid
  allowProfilePhoto          Boolean  @default(true)
  allowLastSeen              Boolean  @default(true)
  allowReadReceipts          Boolean  @default(true)
  allowGroupInvitesFromAll   Boolean  @default(true)
  allowDirectMessagesFromAll Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id            String        @id @default(uuid()) @db.Uuid
  ownerUserId   String        @db.Uuid
  contactUserId String?       @db.Uuid
  savedName     String?       @db.VarChar(120)
  phoneNumber   String        @db.VarChar(20)
  status        ContactStatus @default(PENDING)
  isAppUser     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ownerUser   User  @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  contactUser User? @relation("ContactLinkedUser", fields: [contactUserId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, phoneNumber])
  @@index([ownerUserId])
  @@index([contactUserId])
}

model UserBlock {
  id            String   @id @default(uuid()) @db.Uuid
  blockerUserId String   @db.Uuid
  blockedUserId String   @db.Uuid
  reason        String?  @db.VarChar(255)
  createdAt     DateTime @default(now())

  blockerUser User @relation("BlockerUser", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model OtpRequest {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String?    @db.Uuid
  phoneNumber       String     @db.VarChar(20)
  otpCodeHash       String     @db.VarChar(255)
  channel           OtpChannel
  purpose           OtpPurpose
  status            OtpStatus  @default(PENDING)
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  sentAt            DateTime?
  verifiedAt        DateTime?
  expiresAt         DateTime
  failureReason     String?    @db.VarChar(255)
  providerMessageId String?    @db.VarChar(150)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNumber, purpose])
  @@index([status])
  @@index([expiresAt])
}

model DeviceSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  deviceType       DeviceType
  deviceName       String?       @db.VarChar(120)
  deviceIdentifier String?       @db.VarChar(191)
  ipAddress        String?       @db.VarChar(64)
  userAgent        String?       @db.Text
  pushToken        String?       @db.Text
  status           SessionStatus @default(ACTIVE)
  lastActiveAt     DateTime?
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([status])
}

model RefreshToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  sessionId String?       @db.Uuid
  tokenHash String        @unique @db.VarChar(255)
  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session DeviceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

//
// CONVERSATION DOMAIN
//

model Conversation {
  id              String             @id @default(uuid()) @db.Uuid
  type            ConversationType
  status          ConversationStatus @default(ACTIVE)
  title           String?            @db.VarChar(150)
  description     String?            @db.VarChar(255)
  imageUrl        String?            @db.Text
  createdByUserId String?            @db.Uuid
  lastMessageId   String?            @db.Uuid
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  createdBy      User?                     @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  participants   ConversationParticipant[]
  messages       Message[]
  groupDetail    GroupDetail?
  invites        GroupInvite[]
  pinnedMessages PinnedMessage[]
  userReports    UserReport[]

  @@index([type])
  @@index([status])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id                String            @id @default(uuid()) @db.Uuid
  conversationId    String            @db.Uuid
  userId            String            @db.Uuid
  role              ParticipantRole   @default(MEMBER)
  status            ParticipantStatus @default(ACTIVE)
  joinedAt          DateTime          @default(now())
  leftAt            DateTime?
  mutedUntil        DateTime?
  archivedAt        DateTime?
  lastReadMessageId String?           @db.Uuid
  lastReadAt        DateTime?
  unreadCount       Int               @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId, status])
}

model GroupDetail {
  id                    String                @id @default(uuid()) @db.Uuid
  conversationId        String                @unique @db.Uuid
  inviteLinkCode        String?               @unique @db.VarChar(100)
  joinApprovalMode      GroupJoinApprovalMode @default(ADMIN_APPROVAL)
  memberAddMode         GroupMemberAddMode    @default(ADMINS_ONLY)
  onlyAdminsCanPost     Boolean               @default(false)
  onlyAdminsCanEditInfo Boolean               @default(false)
  maxMembers            Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model GroupInvite {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  invitedUserId   String    @db.Uuid
  invitedByUserId String?   @db.Uuid
  code            String?   @unique @db.VarChar(100)
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  invitedUser  User         @relation(fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("GroupInviteInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([invitedUserId])
}

//
// MESSAGING DOMAIN
//

model Message {
  id               String  @id @default(uuid()) @db.Uuid
  conversationId   String  @db.Uuid
  senderId         String? @db.Uuid
  replyToMessageId String? @db.Uuid

  type   MessageType   @default(TEXT)
  status MessageStatus @default(SENT)

  rawText              String?          @db.Text
  normalizedText       String?          @db.Text
  convertedText        String?          @db.Text
  conversionStatus     ConversionStatus @default(NOT_REQUIRED)
  conversionModel      String?          @db.VarChar(100)
  conversionConfidence Decimal?         @db.Decimal(5, 2)

  caption  String? @db.Text
  metadata Json?

  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?                @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  replyTo      Message?             @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]            @relation("MessageReplies")
  receipts     MessageReceipt[]
  reactions    MessageReaction[]
  edits        MessageEditHistory[]
  attachments  MessageAttachment[]
  pinnedIn     PinnedMessage[]
  reportedIn   UserReport[]         @relation("ReportedMessage")

  @@index([conversationId, sentAt])
  @@index([senderId])
  @@index([replyToMessageId])
  @@index([status])
  @@index([conversionStatus])
}

model MessageReceipt {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @db.Uuid
  userId    String        @db.Uuid
  status    ReceiptStatus
  statusAt  DateTime      @default(now())
  createdAt DateTime      @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, status])
  @@index([userId])
  @@index([messageId, status])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(20)
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

model MessageEditHistory {
  id              String   @id @default(uuid()) @db.Uuid
  messageId       String   @db.Uuid
  editedByUserId  String?  @db.Uuid
  previousText    String?  @db.Text
  newText         String?  @db.Text
  previousRawText String?  @db.Text
  newRawText      String?  @db.Text
  editedAt        DateTime @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editedBy User?   @relation(fields: [editedByUserId], references: [id], onDelete: SetNull)

  @@index([messageId])
}

model PinnedMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  messageId      String   @db.Uuid
  pinnedByUserId String?  @db.Uuid
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

//
// MEDIA DOMAIN
//

model MediaAsset {
  id               String       @id @default(uuid()) @db.Uuid
  uploadedByUserId String?      @db.Uuid
  mediaType        MediaType
  originalFileName String       @db.VarChar(255)
  mimeType         String       @db.VarChar(120)
  fileExtension    String?      @db.VarChar(20)
  fileSizeBytes    BigInt
  width            Int?
  height           Int?
  durationSeconds  Int?
  storageProvider  String       @db.VarChar(50) // e.g. CLOUDINARY / R2
  storageKey       String       @db.VarChar(255)
  secureUrl        String       @db.Text
  thumbnailUrl     String?      @db.Text
  previewUrl       String?      @db.Text
  checksum         String?      @db.VarChar(128)
  uploadStatus     UploadStatus @default(COMPLETED)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  uploadedBy  User?               @relation("MediaUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  attachments MessageAttachment[]

  @@index([uploadedByUserId])
  @@index([mediaType])
  @@index([uploadStatus])
}

model MessageAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @db.Uuid
  mediaAssetId String   @db.Uuid
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([messageId, mediaAssetId])
  @@index([mediaAssetId])
}

//
// MODERATION / AUDIT DOMAIN
//

model UserReport {
  id                String       @id @default(uuid()) @db.Uuid
  reporterUserId    String       @db.Uuid
  reportedUserId    String?      @db.Uuid
  reportedMessageId String?      @db.Uuid
  conversationId    String?      @db.Uuid
  reason            ReportReason
  description       String?      @db.VarChar(500)
  status            ReportStatus @default(OPEN)
  reviewedByUserId  String?      @db.Uuid
  reviewedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  reporter        User          @relation("ReporterUser", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUser    User?         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedMessage Message?      @relation("ReportedMessage", fields: [reportedMessageId], references: [id], onDelete: SetNull)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([reporterUserId])
  @@index([reportedUserId])
  @@index([reportedMessageId])
  @@index([status])
}

model AbuseEvent {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @db.Uuid
  type        AbuseEventType
  severity    Int            @default(1)
  title       String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  metadata    Json?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([occurredAt])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  action      AuditAction
  entityType  String      @db.VarChar(100)
  entityId    String?     @db.VarChar(100)
  description String?     @db.VarChar(500)
  ipAddress   String?     @db.VarChar(64)
  userAgent   String?     @db.Text
  metadata    Json?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

//
// NOTIFICATION DOMAIN
//

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  type      NotificationType
  title     String               @db.VarChar(150)
  body      String               @db.VarChar(255)
  data      Json?
  priority  NotificationPriority @default(NORMAL)
  isRead    Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([type])
}

model NotificationPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  messageNotifications  Boolean  @default(true)
  groupNotifications    Boolean  @default(true)
  otpNotifications      Boolean  @default(true)
  securityNotifications Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDevice {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  deviceToken String       @unique @db.Text
  platform    PushPlatform
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceToken])
}
